<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_ur5e">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import dual_ur5e urdf file -->
    <xacro:include filename="$(find dual_arm_description)/urdf/dual_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="dual_ur5e.ros2_control.xacro" />


    <xacro:dual_ur5e_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
