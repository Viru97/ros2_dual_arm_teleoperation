<?xml version="1.0" encoding="UTF-8"?>
<robot name="dual_ur5e">

  <!-- ── Planning groups ──────────────────────────────────────────────── -->
  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_tool0"/>
  </group>
  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_tool0"/>
  </group>
  <group name="dual_arm">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <group name="left_gripper">
    <joint name="left_finger_joint"/>
  </group>
  <group name="right_gripper">
    <joint name="right_finger_joint"/>
  </group>

  <!-- ── End effectors ────────────────────────────────────────────────── -->
  <end_effector name="left_eef"  parent_link="left_tool0"  group="left_gripper"  parent_group="left_arm"/>
  <end_effector name="right_eef" parent_link="right_tool0" group="right_gripper" parent_group="right_arm"/>

  <!-- ── Virtual joint ────────────────────────────────────────────────── -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_table"/>

  <!-- ══════════════════════════════════════════════════════════════════ -->
  <!-- DISABLED COLLISIONS                                                -->
  <!-- ══════════════════════════════════════════════════════════════════ -->

  <!-- Arm self-collisions (original) -->
  <disable_collisions link1="left_base_link_inertia"  link2="left_shoulder_link"       reason="Adjacent"/>
  <disable_collisions link1="left_base_link_inertia"  link2="right_base_link_inertia"  reason="Adjacent"/>
  <disable_collisions link1="left_base_link_inertia"  link2="right_shoulder_link"      reason="Never"/>
  <disable_collisions link1="left_base_link_inertia"  link2="right_upper_arm_link"     reason="Never"/>
  <disable_collisions link1="left_forearm_link"       link2="left_upper_arm_link"      reason="Adjacent"/>
  <disable_collisions link1="left_forearm_link"       link2="left_wrist_1_link"        reason="Adjacent"/>
  <disable_collisions link1="left_forearm_link"       link2="left_wrist_2_link"        reason="Never"/>
  <disable_collisions link1="left_shoulder_link"      link2="left_upper_arm_link"      reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_link"      link2="right_base_link_inertia"  reason="Never"/>
  <disable_collisions link1="left_shoulder_link"      link2="right_shoulder_link"      reason="Never"/>
  <disable_collisions link1="left_shoulder_link"      link2="right_upper_arm_link"     reason="Never"/>
  <disable_collisions link1="left_upper_arm_link"     link2="right_base_link_inertia"  reason="Never"/>
  <disable_collisions link1="left_upper_arm_link"     link2="right_shoulder_link"      reason="Never"/>
  <disable_collisions link1="left_wrist_1_link"       link2="left_wrist_2_link"        reason="Adjacent"/>
  <disable_collisions link1="left_wrist_1_link"       link2="left_wrist_3_link"        reason="Never"/>
  <disable_collisions link1="left_wrist_2_link"       link2="left_wrist_3_link"        reason="Adjacent"/>
  <disable_collisions link1="right_base_link_inertia" link2="right_shoulder_link"      reason="Adjacent"/>
  <disable_collisions link1="right_forearm_link"      link2="right_upper_arm_link"     reason="Adjacent"/>
  <disable_collisions link1="right_forearm_link"      link2="right_wrist_1_link"       reason="Adjacent"/>
  <disable_collisions link1="right_forearm_link"      link2="right_wrist_2_link"       reason="Never"/>
  <disable_collisions link1="right_shoulder_link"     link2="right_upper_arm_link"     reason="Adjacent"/>
  <disable_collisions link1="right_wrist_1_link"      link2="right_wrist_2_link"       reason="Adjacent"/>
  <disable_collisions link1="right_wrist_1_link"      link2="right_wrist_3_link"       reason="Never"/>
  <disable_collisions link1="right_wrist_2_link"      link2="right_wrist_3_link"       reason="Adjacent"/>

  <!-- ── Left UR-to-Robotiq adapter link ─────────────────────────────── -->
  <!-- Chain: left_wrist_3 → left_flange → left_tool0
                → left_ur_to_robotiq_link (adapter)
                → left_gripper_mount
                → left_robotiq_arg2f_base_link (gripper base) -->
  <disable_collisions link1="left_wrist_3_link"         link2="left_ur_to_robotiq_link"         reason="Never"/>
  <disable_collisions link1="left_wrist_2_link"         link2="left_ur_to_robotiq_link"         reason="Never"/>
  <disable_collisions link1="left_wrist_1_link"         link2="left_ur_to_robotiq_link"         reason="Never"/>
  <disable_collisions link1="left_ur_to_robotiq_link"   link2="left_robotiq_arg2f_base_link"    reason="Adjacent"/>
  <disable_collisions link1="left_wrist_3_link"         link2="left_robotiq_arg2f_base_link"    reason="Never"/>

  <!-- Left gripper internal links -->
  <disable_collisions link1="left_robotiq_arg2f_base_link" link2="left_left_outer_knuckle"       reason="Adjacent"/>
  <disable_collisions link1="left_robotiq_arg2f_base_link" link2="left_right_outer_knuckle"      reason="Adjacent"/>
  <disable_collisions link1="left_robotiq_arg2f_base_link" link2="left_left_inner_knuckle"       reason="Adjacent"/>
  <disable_collisions link1="left_robotiq_arg2f_base_link" link2="left_right_inner_knuckle"      reason="Adjacent"/>
  <disable_collisions link1="left_left_outer_knuckle"      link2="left_left_outer_finger"        reason="Adjacent"/>
  <disable_collisions link1="left_right_outer_knuckle"     link2="left_right_outer_finger"       reason="Adjacent"/>
  <disable_collisions link1="left_left_outer_finger"       link2="left_left_inner_finger"        reason="Never"/>
  <disable_collisions link1="left_right_outer_finger"      link2="left_right_inner_finger"       reason="Never"/>
  <disable_collisions link1="left_left_inner_knuckle"      link2="left_left_inner_finger"        reason="Adjacent"/>
  <disable_collisions link1="left_right_inner_knuckle"     link2="left_right_inner_finger"       reason="Adjacent"/>
  <disable_collisions link1="left_left_inner_finger"       link2="left_left_inner_finger_pad"    reason="Adjacent"/>
  <disable_collisions link1="left_right_inner_finger"      link2="left_right_inner_finger_pad"   reason="Adjacent"/>
  <disable_collisions link1="left_left_outer_knuckle"      link2="left_right_outer_knuckle"      reason="Never"/>
  <disable_collisions link1="left_left_inner_finger"       link2="left_right_inner_finger"       reason="Never"/>
  <disable_collisions link1="left_left_inner_finger_pad"   link2="left_right_inner_finger_pad"   reason="Never"/>
  <!-- Adapter vs gripper knuckles -->
  <disable_collisions link1="left_ur_to_robotiq_link"      link2="left_left_outer_knuckle"       reason="Never"/>
  <disable_collisions link1="left_ur_to_robotiq_link"      link2="left_right_outer_knuckle"      reason="Never"/>
  <disable_collisions link1="left_ur_to_robotiq_link"      link2="left_left_inner_knuckle"       reason="Never"/>
  <disable_collisions link1="left_ur_to_robotiq_link"      link2="left_right_inner_knuckle"      reason="Never"/>

  <!-- ── Right UR-to-Robotiq adapter link ────────────────────────────── -->
  <disable_collisions link1="right_wrist_3_link"        link2="right_ur_to_robotiq_link"        reason="Never"/>
  <disable_collisions link1="right_wrist_2_link"        link2="right_ur_to_robotiq_link"        reason="Never"/>
  <disable_collisions link1="right_wrist_1_link"        link2="right_ur_to_robotiq_link"        reason="Never"/>
  <disable_collisions link1="right_ur_to_robotiq_link"  link2="right_robotiq_arg2f_base_link"   reason="Adjacent"/>
  <disable_collisions link1="right_wrist_3_link"        link2="right_robotiq_arg2f_base_link"   reason="Never"/>

  <!-- Right gripper internal links -->
  <disable_collisions link1="right_robotiq_arg2f_base_link" link2="right_left_outer_knuckle"     reason="Adjacent"/>
  <disable_collisions link1="right_robotiq_arg2f_base_link" link2="right_right_outer_knuckle"    reason="Adjacent"/>
  <disable_collisions link1="right_robotiq_arg2f_base_link" link2="right_left_inner_knuckle"     reason="Adjacent"/>
  <disable_collisions link1="right_robotiq_arg2f_base_link" link2="right_right_inner_knuckle"    reason="Adjacent"/>
  <disable_collisions link1="right_left_outer_knuckle"      link2="right_left_outer_finger"      reason="Adjacent"/>
  <disable_collisions link1="right_right_outer_knuckle"     link2="right_right_outer_finger"     reason="Adjacent"/>
  <disable_collisions link1="right_left_outer_finger"       link2="right_left_inner_finger"      reason="Never"/>
  <disable_collisions link1="right_right_outer_finger"      link2="right_right_inner_finger"     reason="Never"/>
  <disable_collisions link1="right_left_inner_knuckle"      link2="right_left_inner_finger"      reason="Adjacent"/>
  <disable_collisions link1="right_right_inner_knuckle"     link2="right_right_inner_finger"     reason="Adjacent"/>
  <disable_collisions link1="right_left_inner_finger"       link2="right_left_inner_finger_pad"  reason="Adjacent"/>
  <disable_collisions link1="right_right_inner_finger"      link2="right_right_inner_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="right_left_outer_knuckle"      link2="right_right_outer_knuckle"    reason="Never"/>
  <disable_collisions link1="right_left_inner_finger"       link2="right_right_inner_finger"     reason="Never"/>
  <disable_collisions link1="right_left_inner_finger_pad"   link2="right_right_inner_finger_pad" reason="Never"/>
  <!-- Adapter vs gripper knuckles -->
  <disable_collisions link1="right_ur_to_robotiq_link"      link2="right_left_outer_knuckle"     reason="Never"/>
  <disable_collisions link1="right_ur_to_robotiq_link"      link2="right_right_outer_knuckle"    reason="Never"/>
  <disable_collisions link1="right_ur_to_robotiq_link"      link2="right_left_inner_knuckle"     reason="Never"/>
  <disable_collisions link1="right_ur_to_robotiq_link"      link2="right_right_inner_knuckle"    reason="Never"/>

</robot>